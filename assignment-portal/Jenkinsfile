
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Assignment Portal CI/CD Pipeline Started'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'whoami'
                bat 'where docker'
                bat 'docker --version'
                bat 'docker info'
            }
        }
    }
}
