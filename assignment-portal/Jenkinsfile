
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Assignment Portal source code checked out'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'whoami'
                bat 'where docker'
                bat 'docker --version'
                bat 'docker info'
            }
        }
    }

    post {
        success {
            echo 'Jenkins and Docker connection test successful!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
