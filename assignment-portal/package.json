{
  "name": "assignment-portal",
  "version": "1.0.0",
  "description": "Online Assignment Submission and Evaluation Portal",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "assignment",
    "portal",
    "education",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "",
  "license": "MIT"
}
