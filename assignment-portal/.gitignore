# =============================================================================
# Assignment Portal — .gitignore
# =============================================================================

# Environment files — NEVER commit
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env

# Node modules
node_modules/
*/node_modules/

# Build output
frontend/dist/
frontend/build/
backend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Upload directory (runtime files)
backend/uploads/*
!backend/uploads/.gitkeep

# Test coverage
coverage/
*/coverage/
.nyc_output/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Docker
docker-compose.override.yml

# Temporary files
*.tmp
*.temp
.cache/

# Jenkins workspace artifacts
jenkins_home/
